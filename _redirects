# Netlify redirects — imautotech.in (apex)
# Product marketing/legal pages now live on dedicated subdomains.
# 301! is forced so the redirect fires even though the old files still exist in the deploy.
# Note: /our_products/<product>/files/*.apk are intentionally NOT redirected — the
# subdomains don't host /files/*, so the old APK download links keep working from the apex.

# ── Arc Launcher → arclauncher.imautotech.in ──
/our_products/arc_launcher/arcLauncher.html        https://arclauncher.imautotech.in/                       301!
/our_products/arc_launcher/privacy-policy.html     https://arclauncher.imautotech.in/privacy-policy.html    301!
/our_products/arc_launcher/terms-of-service.html   https://arclauncher.imautotech.in/terms-of-service.html  301!
/our_products/arc_launcher/contact.html            https://arclauncher.imautotech.in/contact.html           301!

# ── WX Gamepad → wxgamepad.imautotech.in ──
/our_products/wx_gamepad/wxgamepad.html            https://wxgamepad.imautotech.in/                         301!
/our_products/wx_gamepad/privacy-policy.html       https://wxgamepad.imautotech.in/privacy-policy.html      301!
/our_products/wx_gamepad/terms-of-service.html     https://wxgamepad.imautotech.in/terms-of-service.html    301!
/our_products/wx_gamepad/contact.html              https://wxgamepad.imautotech.in/contact.html             301!

# ── Watch Party → watchparty.imautotech.in (marketing/legal only; the web app at /watchparty/ and invites stay on the apex) ──
/our_products/watch_party/watchparty.html          https://watchparty.imautotech.in/                        301!
/our_products/watch_party/privacy-policy.html      https://watchparty.imautotech.in/privacy-policy.html     301!
/our_products/watch_party/terms-of-service.html    https://watchparty.imautotech.in/terms-of-service.html   301!
/our_products/watch_party/contact.html             https://watchparty.imautotech.in/contact.html            301!

# ── Rentle → rentle.imautotech.in (no in-repo landing page existed) ──
/our_products/rentle/privacy-policy.html           https://rentle.imautotech.in/privacy-policy.html         301!
/our_products/rentle/terms-of-service.html         https://rentle.imautotech.in/terms-of-service.html       301!
/our_products/rentle/contact.html                  https://rentle.imautotech.in/contact.html                301!

# ── PlayParty premium (PhonePe) — the approved merchant domain hosts both the post-payment
#    redirect and the S2S webhook. The webhook proxies to PlayParty's Supabase callback. ──
/playparty/return            /playparty/return.html                                  200
/playparty/phonepe-webhook   /.netlify/functions/playparty-phonepe-webhook           200!

# ── WatchParty premium (PhonePe via the hub) — post-payment browser redirect. ──
/watchparty/return           /watchparty/return.html                                 200

# ── Central payment hub (one PhonePe gateway for all Autotech apps) ──
#    /pay/create   server-to-server, signed per app   ·   /pay/webhook  the single PhonePe webhook
/pay/create                  /.netlify/functions/pay-create                          200!
/pay/webhook                 /.netlify/functions/pay-webhook                         200!

# ── Consultancy booking (imautotech's own ₹1,999/hr fee, paid via the hub) ──
/consultation/thanks         /consultation/thanks.html                               200
# Edge-function SOURCE lives in the repo for version control but must not be served publicly.
/supabase/*                  /404.html                                               404!
